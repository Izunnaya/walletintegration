# The wallet API. No trailing slash.
#
# Local development runs the API from server/ on port 3000, and this UI on 3001 - which is
# why the server's CORS_ORIGINS lists both. Vite only exposes variables prefixed VITE_ to
# the browser, which is the point: anything in here is public once the app is built.
VITE_API_BASE_URL=http://localhost:3000

# The deployed API, for reference:
# VITE_API_BASE_URL=https://walletintegration-6t6r.onrender.com
