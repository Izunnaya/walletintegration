* text=auto eol=lf

# Collapsed in GitHub diffs and excluded from language stats. These are machine output: a
# reviewer should read the change to package.json, not the three thousand lines the lockfile
# regenerates around it. The last pull request looked like 3k changes and was ~700 of code.
server/package-lock.json linguist-generated=true
package-lock.json        linguist-generated=true

# The Prisma client, if it is ever committed. It is currently regenerated by postinstall.
server/src/generated/** linguist-generated=true

# A Postman collection is exported data, not code. Collapsed for the same reason.
docs/*.postman_collection.json linguist-generated=true
