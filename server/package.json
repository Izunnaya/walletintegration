{
  "name": "wallet-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "migrate": "prisma migrate deploy",
    "seed": "prisma db seed",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:baseline": "prisma migrate resolve --applied 0_init",
    "test:unit": "vitest run tests/money.test.ts tests/transferPolicy.test.ts tests/seedCommand.test.ts tests/auth.test.ts tests/transferRetry.test.ts",
    "test:integration": "vitest run tests/schema.test.ts tests/seed.test.ts tests/auth.integration.test.ts tests/transfers.integration.test.ts --no-file-parallelism",
    "verify:prisma": "node scripts/verify-prisma.mjs",
    "reconcile": "node src/reconcile.ts",
    "admin:password": "node src/setAdminPassword.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
