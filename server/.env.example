PORT=3000

# The database. The integration tests use this same database and schema: they do their work
# inside transactions that are always rolled back, so they leave it exactly as they found it.
DATABASE_URL=postgresql://wallet_user:replace_me@localhost:5432/wallet_service

# Signing key for the session token. At least 32 characters; a short one can be brute
# forced offline. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_at_least_32_characters_of_random_hex
